# ============================================================
# CoreCoder 环境变量示例。复制为 .env 后按需修改。
#
# 加载机制（corecoder/config.py::_load_dotenv）：
#   - 从当前目录逐级向上找 .env，找到家目录为止（家目录本身的 .env 不被检查）；
#     所以在别的项目里用 corecoder，要么在项目根放一份 .env，
#     要么把关键变量设成用户级环境变量（setx）。
#   - load_dotenv(override=False)：进程/系统环境变量永远优先于 .env 文件。
#   - corecoder --demo 不加载 .env（cli.py 在 Config.from_env() 之前就进 demo），
#     不要用 --demo 验收这里的任何配置。
#
# 布尔开关统一认 1/true/yes/on（大小写不敏感），其余值一律视为关闭
# （corecoder/audit.py::truthy）。
# 本文件里的"默认值"指代码内置值；不设置就是该默认。
# ============================================================

# ---------- 1. 模型与服务商（缺一跑不了真实任务） ----------

# API key。读取优先级：CORECODER_API_KEY > OPENAI_API_KEY > DEEPSEEK_API_KEY
# （config.py::Config.from_env）。三个只需设一个；没有 key 时 CLI 打印帮助并退出。
OPENAI_API_KEY=sk-xxxx
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=

# OpenAI 兼容网关地址。默认跟随服务商官方地址（不设则 SDK 默认值）。
OPENAI_BASE_URL=https://api.openai.com/v1
# 等价别名（config.py::Config.from_env，二选一）：
# CORECODER_BASE_URL=

# 模型名。默认 gpt-5.5（config.py::Config.from_env）——换网关时必须同步改，否则 404。
CORECODER_MODEL=gpt-5.5

# 单次回答的输出 token 上限。默认 4096（config.py::Config.from_env）。
# 撞上限会产生 TruncatedOutput 错误并在 audit 记 output_truncated 事件；
# 按服务商 completion 上限留足提示词余量来设，例如小米 mimo 网关顶 131072，取 16384。
CORECODER_MAX_TOKENS=4096

# 采样温度。默认 0（config.py::Config.from_env），agent 负载建议保持 0。
CORECODER_TEMPERATURE=0

# 上下文窗口预算（token）。默认 128000（config.py::Config.from_env），超限触发上下文压缩。
CORECODER_MAX_CONTEXT=128000

# LLM 提供方实现：openai | litellm（config.py::Config.from_env）。litellm 走 LiteLLM 类，
# 需要安装 extras：pip install -e ".[litellm]"。
CORECODER_PROVIDER=openai

# ---------- 2. 审计流（corecoder/audit.py，~/.corecoder/audit.<pid>.log） ----------
# 纯元数据事件流：谁、何时、多久、花了多少；不含工具参数/结果/用户输入。

# 总开关。默认关（不设 = 完全不写审计）。阶段 1 dogfood 必开。
CORECODER_AUDIT=true

# 保留最近多少个 audit.<pid>.log（数的是进程数，不是天数）。
# 默认 10（audit.py::_DEFAULT_KEEP），实测连一天真实运行都留不住；
# 长期自用时提到几百（实测约 0.5-1MB/天，500 个封顶 50MB 量级）。
# 非数字静默回退默认值。
CORECODER_AUDIT_KEEP=10

# 单个审计文件的体积上限（MB），超出即 os.replace 成 .1 且只留一份。
# 默认 100（audit.py::_open_audit_file）。对几 KB 的 pid 小文件几乎不触发，仅作兜底。
# CORECODER_AUDIT_MAX_MB=100

# 审计行级别门槛，默认 INFO（audit.py::_install_sink）。调高会滤掉普通事件，一般不动。
# CORECODER_AUDIT_LEVEL=INFO

# 【故意不推荐设置】CORECODER_AUDIT_FILE：显式指定固定路径会 ①跳过 prune
# （保留逻辑只在默认路径生效，见 dogfood-plan.md 3.3 第 1 条）
# ②放弃 pid 分文件的进程隔离（Windows 两终端交错写同一 fd 无保证）。
# CORECODER_AUDIT_FILE=

# 【故意不推荐设置】CORECODER_AUDIT_STREAM=stderr：会把审计流改喷 stderr，
# 文件一个字都不落，且污染 REPL 终端。主要供调试/测试隔离用。
# CORECODER_AUDIT_STREAM=

# ---------- 3. 追踪流（corecoder/tracing.py，完整现场录像） ----------
# 回答"它为什么这么干"：提示词、模型输出、工具 I/O 都在这一路（受 CONTENT 开关控制）。

# 后端：off | jsonl | langfuse。默认 off（tracing.py::create_tracer，不设 = 不录像）。
# 注意：选 langfuse 但 SDK/密钥缺失时退回 NullTracer，【不会】自动降级写文件。
CORECODER_TRACE=off

# 是否录制内容（提示词/输出/工具 I/O，含源代码）。默认关（tracing.py::_resolve_capture_content）。
# 开启时进程内警告一次"redaction is best-effort"——敏感文本会进观测库，自托管可接受。
# 关掉后 trace 只剩结构与数字，B4（root output）等按轮正文一并消失。
CORECODER_TRACE_CONTENT=

# 【仅 jsonl 后端读取】录像文件路径；不设则 ~/.corecoder/traces.<pid>.jsonl。
# langfuse 后端根本不读它，只改路径关不住 langfuse（dogfood-plan.md 0-1 注意点）。
# CORECODER_TRACE_FILE=

# 【仅 jsonl 后端读取】单文件体积上限（MB），默认 100（tracing.py::_max_trace_bytes）。
# CORECODER_TRACE_MAX_MB=100

# ---------- 4. Langfuse 连接（backend=langfuse 时必需） ----------
# 缺 key 则整个后端退化成 NullTracer（静默）：tracing.py::LangfuseTracer 构造时校验两个 key。
# 值是本地实例自定的，非官方颁发；host 服务没起时 SDK 不报错但数据投递失败。

# LANGFUSE_HOST：SDK 读取（corecoder 代码不直接 getenv）。本地 docker-compose 默认 3000。
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx

# 数据分库标签（Langfuse 界面顶部的 environment 选择器）。默认 default。
# 必须在首次 get_client() 之前存在——设为进程/用户环境变量即可天然满足。
# 真实使用建议独立成库，如 dogfood，与测试产物（conftest 置 test）隔离。
LANGFUSE_TRACING_ENVIRONMENT=default

# ---------- 5. 运行打标（corecoder/agent.py 读取，同时进 audit 与 trace） ----------

# 运行来源/批次标签。默认空（不设则 audit 行 build= 为空、trace 无 build: tag）。
# 本仓库复用它为 dogfood 来源标签：audit 记 build=dogfood，
# trace 打 tags=["build:dogfood"]（Langfuse tags 创建后不可变，随 root span 一次传入）。
# 阶段 1 验收"≥20 次真实会话"数的就是它——跨目录跑务必配到用户环境变量级。
CORECODER_BUILD=

# 运行者署名（trace 的 userId 维度）。默认不记（agent.py::Agent._labels，姓名属个人数据，
# 只允许显式提供）。不设则 userId 恒为 None。
# CORECODER_USER=

# ---------- 6. 工具 schema 延迟加载（corecoder/agent.py::_should_defer，对标业界 tool search） ----------
# MCP 工具很多时，完整 JSON schema 每轮都随 tools= 全量下发。开启后：默认只在
# 提示里留一份"MCP 工具名 + 极短摘要"索引，模型调 search_tools(关键词) 命中后，
# 对应工具的完整 schema 才从下一轮起纳入请求（append-only，保持 provider 前缀缓存）。
# 只影响 MCP 工具；内置工具与子 agent 工具始终全量下发。截断 description 的路线
# 不采用——业界共识是"延迟加载"而非"砍描述"（砍描述会削弱模型选工具的能力）。

# 模式：off | auto | on。默认 auto。
#   auto：仅当 MCP 命中下面的数量/体积阈值才启用（小工具集逐字不变，零回归）。
#   on：只要有 MCP 就延迟（压测/演示用）。off：永不延迟（一键回退到全量 eager）。
CORECODER_TOOL_SEARCH=auto

# auto 的数量阈值：MCP 工具数达到该值即启用延迟。默认 10。非数字静默回退默认。
# CORECODER_TOOL_SEARCH_MIN_COUNT=10

# auto 的体积阈值：MCP schema 估算 token 占上下文窗口（CORECODER_MAX_CONTEXT）
# 的百分比达到该值即启用。默认 8。与数量阈值任一满足即触发。
# CORECODER_TOOL_SEARCH_PCT=8

# ---------- 7. 通用运维日志（非审计流！corecoder logger：hook 警告、MCP 降级、trace_disabled 告警） ----------

# 级别，默认 WARNING（audit.py::configure_logging）。想看上面三类降级告警的 DEBUG 细节才调。
# CORECODER_LOG_LEVEL=WARNING

# 输出文件；不设则打 stderr。注意：trace 后端起不来的一次性警告
# （event=trace_disabled）走这条流，跨目录排障时可以临时指到一个文件方便回看。
# CORECODER_LOG_FILE=

# ---------- 8. 不是环境变量的配置（放在 ~/.corecoder/ 下，一并备忘） ----------
# ~/.corecoder/pricing.json   —— 模型单价表，缺条目则该运行 cost_usd=None
#                                 （corecoder/llm.py::PRICING_FILE；dogfood-plan.md 0-3/B3）
# ~/.corecoder/hooks.json     —— 工具调用钩子定义（corecoder/hooks.py::HOOKS_FILE）
# ~/.corecoder/mcp.json       —— MCP 服务器配置（corecoder/mcp.py::CONFIG_FILE；
#                                 示例见 examples/mcp_filesystem.json）
# ~/.corecoder/permissions.json —— "always allow" 授权持久化（corecoder/permissions.py::DEFAULT_STORE）
